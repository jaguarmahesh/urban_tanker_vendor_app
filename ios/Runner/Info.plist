<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- General Application Settings -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    
    <key>CFBundleName</key>
    <string>Urban Tanker Vendor</string>
    
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    
    <key>CFBundleSignature</key>
    <string>????</string>
    
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- iOS Requirements -->
    <key>MinimumOSVersion</key>
    <string>11.0</string>

    <!-- Display & UI -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Location Permissions -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Urban Tanker Vendor needs access to your location to track deliveries and optimize routes.</string>
    
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Urban Tanker Vendor needs continuous access to your location for real-time delivery tracking.</string>
    
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Urban Tanker Vendor needs continuous access to your location for background delivery tracking.</string>

    <!-- Notification Permissions -->
    <key>NSUserNotificationsUsageDescription</key>
    <string>Urban Tanker Vendor sends notifications for new orders and delivery updates.</string>

    <!-- Camera Permission (for profile photo) -->
    <key>NSCameraUsageDescription</key>
    <string>Urban Tanker Vendor needs access to your camera to upload a profile photo.</string>

    <!-- Photo Library Permissions -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Urban Tanker Vendor needs access to your photo library to upload profile images and delivery photos.</string>
    
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Urban Tanker Vendor needs access to save delivery photos to your photo library.</string>

    <!-- Contact Permissions -->
    <key>NSContactsUsageDescription</key>
    <string>Urban Tanker Vendor needs access to contacts for quick communication with drivers.</string>

    <!-- Calendar Permissions (optional, for delivery scheduling) -->
    <key>NSCalendarsUsageDescription</key>
    <string>Urban Tanker Vendor can add delivery schedules to your calendar.</string>

    <!-- Background Modes -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>remote-notification</string>
        <string>processing</string>
    </array>

    <!-- Status Bar Configuration -->
    <key>UIStatusBarHidden</key>
    <false/>
    
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
    
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- Networking Configuration -->
    <key>NSBonjourServices</key>
    <array>
        <string>_http._tcp</string>
        <string>_https._tcp</string>
    </array>

    <!-- Allow HTTP for localhost during development -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>localhost</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSTemporaryExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
            <key>127.0.0.1</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSTemporaryExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>

    <!-- Firebase Configuration -->
    <key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
    <true/>
    
    <key>FIREBASE_PERFORMANCE_COLLECTION_ENABLED</key>
    <true/>

    <!-- Google Maps Configuration -->
    <key>GoogleMapsApiKey</key>
    <string>YOUR_GOOGLE_MAPS_API_KEY_HERE</string>

    <!-- Additional URL Schemes for Deep Linking -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.urban_tanker.vendor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>urban_tanker</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.facebook.sdk</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>fb</string>
            </array>
        </dict>
    </array>

    <!-- Query Schemes for Deep Linking -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>fbapi</string>
        <string>fb-messenger</string>
        <string>fbauth2</string>
        <string>fbshareextension</string>
        <string>maps</string>
        <string>tel</string>
        <string>sms</string>
    </array>

    <!-- Font Import (Poppins) -->
    <key>UIAppFonts</key>
    <array>
        <string>Poppins-Regular.ttf</string>
        <string>Poppins-Medium.ttf</string>
        <string>Poppins-SemiBold.ttf</string>
        <string>Poppins-Bold.ttf</string>
        <string>Poppins-ExtraBold.ttf</string>
    </array>

</dict>
</plist>
